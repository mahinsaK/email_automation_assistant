# Get this token from Telegram's BotFather.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Optional but recommended: only this Telegram user ID may use the bot.
ALLOWED_TELEGRAM_USER_ID=

# Required to store per-user AI credentials. Generate a Fernet key as documented.
CREDENTIAL_ENCRYPTION_KEY=

# SQLite persistence for encrypted per-user AI configuration.
DATABASE_PATH=data/email_assistant.db

# Local Phase 4 profile and CV metadata sources. Keep personal files out of Git.
CANDIDATE_PROFILE_PATH=data/candidate_profile.json
CV_FILE_PATH=attachments/CV.pdf

# Optional application-level development fallback. Per-user credentials take precedence.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO

