# Get this token from Telegram's BotFather.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Optional but recommended: only this Telegram user ID may use the bot.
ALLOWED_TELEGRAM_USER_ID=

# AI is enabled only when provider is openai and a key is present.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO

